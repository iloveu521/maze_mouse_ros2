<?xml version="1.0"?>
<!--
  Z 型迷宫（圆弧版，3 个转弯，出口顶部走廊尽头）
  ============================================================
  规格（圆弧版）：走廊宽 2.0 m，转弯半径 1.5 m（内墙弧半径 0.5 m），
  墙高 1.2 m，墙厚 0.3 m；全图无直角、无锐角（转弯圆弧 + 圆头柱）。
  打开方式：
    方式一（Gazebo 11 直接打开）：gazebo z_maze
    方式二（ROS2）：ros2 launch gazebo_ros gazebo.launch.py world:=z_maze
  加载小车（出生点在入口，车头朝 +x）：
        export TURTLEBOT3_MODEL=burger
        ros2 run gazebo_ros spawn_entity.py \
          -file "$(ros2 pkg prefix turtlebot3_gazebo)/share/turtlebot3_gazebo/models/turtlebot3_burger/model.sdf" \
          -entity tb3_burger -x 0.0 -y 2.0 -z 0.02
  验证：python3 astar_maze.py z_maze 0.0 2.0 8.0 8.0
-->
<sdf version="1.6">
  <world name="">
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>
    <light type="ambient" name="ambient_light">
      <diffuse>0.3 0.3 0.3 1</diffuse>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <pose>4.000 5.000 -0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>11.60 9.60 0.2</size></box></geometry>
          <surface>
            <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>11.60 9.60 0.2</size></box></geometry>
          <material>
            <ambient>0.75 0.78 0.82 1</ambient>
            <diffuse>0.75 0.78 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- ============ 迷宫墙体（深蓝灰；box 墙段 + 圆柱圆头） ============ -->
