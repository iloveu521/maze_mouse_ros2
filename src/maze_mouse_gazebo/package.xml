  <description>Six metre teaching maze and TurtleBot3 Burger simulation for ROS 2 Humble.</description>
  <maintainer email="maintainer@example.com">Maze Mouse Project</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
