<?xml version="1.0"?>
<package format="3">
  <name>maze_mouse_navigation</name>
  <version>0.1.0</version>
  <description>C++20 laser-centred navigation and online flood-fill planning for a grid maze.</description>
  <maintainer email="maintainer@example.com">Maze Mouse Project</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>maze_mouse_gazebo</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
